# ==============================================================================
# Persian Web Store (PWS) - Production Environment Variables
# Copy this file to .env.prod and replace placeholder values before deploying.
# Command to generate strong 64-character secrets: openssl rand -hex 32
# ==============================================================================

# PostgreSQL 16 Database Configuration
POSTGRES_DB=pws
POSTGRES_USER=pws
POSTGRES_PASSWORD=replace_with_strong_database_password

# Authentication & Cryptographic Secrets (MUST be at least 32 bytes / 64 hex chars)
APP_JWT_STAFF_SECRET=replace_with_openssl_rand_hex_32_for_staff_jwt
APP_JWT_CUSTOMER_SECRET=replace_with_openssl_rand_hex_32_for_customer_jwt
APP_OTP_SECRET=replace_with_openssl_rand_hex_32_for_otp_hmac

# Cookie Security:
# Set to 'true' in production with HTTPS (https://proteinirany.ir)
# Set to 'false' only during initial local/IP testing without SSL
APP_COOKIES_SECURE=true

# Let's Encrypt / Certbot Contact Email (for renewal notices and security alerts)
CERTBOT_EMAIL=ali.saranj1384@gmail.com

# Media Directory (inside API container)
APP_MEDIA_DIR=/media

# SMS Gateway Configuration
# Options: 'logging' (prints OTP codes to docker logs) or 'kavenegar'
APP_SMS_PROVIDER=logging
APP_SMS_KAVENEGAR_API_KEY=
APP_SMS_KAVENEGAR_BASE_URL=https://api.kavenegar.com
# Set to the approved Kavenegar lookup template name (e.g. 'SMS' or 'pws-otp')
APP_SMS_KAVENEGAR_TEMPLATE_OTP=SMS
APP_SMS_KAVENEGAR_TEMPLATE_ORDER_PAID=pws-order-paid
APP_SMS_KAVENEGAR_TEMPLATE_ORDER_APPROVED=pws-order-approved
APP_SMS_KAVENEGAR_TEMPLATE_ORDER_SHIPPED=pws-order-shipped

# Payment Gateway Configuration
APP_PAYMENT_ACTIVE_GATEWAY=TABAPAY

# TabaPay Configuration
# Get your merchant UUID from your tabapay.ir dashboard
APP_TABAPAY_MERCHANT_ID=replace_with_your_tabapay_merchant_uuid
APP_TABAPAY_SANDBOX=false
APP_TABAPAY_CALLBACK_URL=https://proteinirany.ir/checkout/callback

# Zarinpal Configuration (Fallback)
APP_ZARINPAL_MERCHANT_ID=sandbox-merchant-id-0123456789
APP_ZARINPAL_SANDBOX=true
APP_ZARINPAL_CALLBACK_URL=https://proteinirany.ir/api/shop/payments/zarinpal/callback

# Initial Bootstrap Owner Account (created automatically on first boot if no staff exists)
APP_BOOTSTRAP_OWNER_USERNAME=owner
APP_BOOTSTRAP_OWNER_PASSWORD=replace_with_initial_strong_owner_password
APP_BOOTSTRAP_OWNER_MOBILE=09136978682
